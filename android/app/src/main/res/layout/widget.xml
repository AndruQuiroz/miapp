<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/widget_fondo">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Mi App"
            android:textColor="#E6EDF3"
            android:textSize="15sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/w_caja"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="caja —"
            android:textColor="#0BB877"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/w_linea"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="2"
        android:ellipsize="end"
        android:text="Abre la app una vez para ver tus datos"
        android:textColor="#9AA7B4"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/w_voz"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="2"
            android:background="@drawable/widget_boton_verde"
            android:gravity="center"
            android:text="🎙️ Contar"
            android:textColor="#04130C"
            android:textSize="15sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/w_pend"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/widget_boton"
            android:gravity="center"
            android:text="📋"
            android:textColor="#E6EDF3"
            android:textSize="15sp" />
        <TextView
            android:id="@+id/w_asis"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/widget_boton"
            android:gravity="center"
            android:text="💬"
            android:textColor="#E6EDF3"
            android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>
